# Used both from CMakeLists.txt and from cmake -P for deterministic validation.
# Inputs: ASSISTANT_PACKAGE_DIR, ASSISTANT_PACKAGE_URL, ASSISTANT_PACKAGE_SHA256,
#         ASSISTANT_PACKAGE_OUTPUT, ASSISTANT_PACKAGE_REQUIRED
cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED ASSISTANT_PACKAGE_OUTPUT OR ASSISTANT_PACKAGE_OUTPUT STREQUAL "")
  message(FATAL_ERROR "ASSISTANT_PACKAGE_OUTPUT must be specified")
endif()
if(ASSISTANT_PACKAGE_DIR AND ASSISTANT_PACKAGE_URL)
  message(FATAL_ERROR "Specify ASSISTANT_PACKAGE_DIR or ASSISTANT_PACKAGE_URL, not both")
endif()

if(NOT ASSISTANT_PACKAGE_DIR AND NOT ASSISTANT_PACKAGE_URL)
  if(ASSISTANT_PACKAGE_REQUIRED)
    message(FATAL_ERROR "Provide ASSISTANT_PACKAGE_DIR or ASSISTANT_PACKAGE_URL")
  endif()
  message(STATUS "No model package selected. UI can select an existing local release folder at runtime.")
  return()
endif()

set(_archive_root "${ASSISTANT_PACKAGE_OUTPUT}/.archive-extract")
set(_source "")
if(ASSISTANT_PACKAGE_DIR)
  get_filename_component(_source "${ASSISTANT_PACKAGE_DIR}" ABSOLUTE)
  if(NOT IS_DIRECTORY "${_source}")
    message(FATAL_ERROR "Model package folder not found: ${_source}")
  endif()
else()
  if(NOT ASSISTANT_PACKAGE_URL MATCHES "^https://")
    message(FATAL_ERROR "Package download URL must use HTTPS")
  endif()
  string(TOLOWER "${ASSISTANT_PACKAGE_SHA256}" _expected_sha)
  if(NOT ASSISTANT_PACKAGE_SHA256 MATCHES "^[a-fA-F0-9]+$")
    message(FATAL_ERROR "ASSISTANT_PACKAGE_SHA256 must be a 64-character hexadecimal digest")
  endif()
  string(LENGTH "${ASSISTANT_PACKAGE_SHA256}" _sha_len)
  if(NOT _sha_len EQUAL 64)
    message(FATAL_ERROR "ASSISTANT_PACKAGE_SHA256 must have 64 hex digits")
  endif()
  file(MAKE_DIRECTORY "${ASSISTANT_PACKAGE_OUTPUT}")
  set(_archive "${ASSISTANT_PACKAGE_OUTPUT}/model-package.zip")
  set(_download TRUE)
  if(EXISTS "${_archive}")
    file(SHA256 "${_archive}" _got)
    if(_got STREQUAL _expected_sha)
      set(_download FALSE)
    endif()
  endif()
  if(_download)
    set(_partial "${_archive}.partial")
    file(DOWNLOAD "${ASSISTANT_PACKAGE_URL}" "${_partial}"
      STATUS _status
      TLS_VERIFY ON TIMEOUT 1200 INACTIVITY_TIMEOUT 60 SHOW_PROGRESS)
    list(GET _status 0 _result)
    list(GET _status 1 _message)
    if(NOT _result EQUAL 0)
      file(REMOVE "${_partial}")
      message(FATAL_ERROR "Verified model package download failed: ${_message}")
    endif()
    file(SHA256 "${_partial}" _got)
    if(NOT _got STREQUAL _expected_sha)
      file(REMOVE "${_partial}")
      message(FATAL_ERROR "Model package SHA256 does not match ASSISTANT_PACKAGE_SHA256")
    endif()
    file(RENAME "${_partial}" "${_archive}")
  endif()
  set(_extract TRUE)
  if(EXISTS "${_archive_root}/.package-sha256")
    file(READ "${_archive_root}/.package-sha256" _extracted_sha)
    if(_extracted_sha STREQUAL _expected_sha)
      set(_extract FALSE)
    endif()
  endif()
  if(_extract)
    file(REMOVE_RECURSE "${_archive_root}")
    file(MAKE_DIRECTORY "${_archive_root}")
    file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_archive_root}")
    file(WRITE "${_archive_root}/.package-sha256" "${_expected_sha}")
  endif()
  set(_source "${_archive_root}")
endif()

# Supported archive layouts: files at root, or a single release/ subfolder.
if(NOT EXISTS "${_source}/knowledge.db" AND EXISTS "${_source}/release/knowledge.db")
  set(_source "${_source}/release")
endif()
if(NOT EXISTS "${_source}/knowledge.db")
  message(FATAL_ERROR "Package requires knowledge.db at root or inside release/")
endif()
if(NOT EXISTS "${_source}/assistant.gguf")
  file(GLOB _shards "${_source}/model-shards/*.gguf")
  if(NOT _shards)
    message(FATAL_ERROR "Package requires assistant.gguf or model-shards/*.gguf")
  endif()
endif()

set(_release_files assistant.gguf knowledge.db manifest.json SHA256SUMS.txt evaluation.json
  OUTPUT_FORMAT.txt source_failures.json analysis_summary.json BASE_MODEL_LICENSE.txt
  BASE_MODEL_CARD.md source_coverage.json training_metrics.json answer_review.json)
if(EXISTS "${_source}/SHA256SUMS.txt")
  file(STRINGS "${_source}/SHA256SUMS.txt" _checksum_rows)
  foreach(_row IN LISTS _checksum_rows)
    if(NOT _row MATCHES "^([0-9A-Fa-f]+)  (.+)$")
      message(FATAL_ERROR "Invalid SHA256SUMS.txt entry")
    endif()
    string(TOLOWER "${CMAKE_MATCH_1}" _file_sha)
    set(_relative "${CMAKE_MATCH_2}")
    string(REPLACE "\\" "/" _relative "${_relative}")
    string(LENGTH "${_file_sha}" _file_sha_length)
    if(NOT _file_sha_length EQUAL 64 OR NOT _relative MATCHES "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        OR _relative MATCHES "(^|/)\\.\\.?(/|$)")
      message(FATAL_ERROR "Invalid release checksum or file path")
    endif()
    if(NOT EXISTS "${_source}/${_relative}" OR IS_DIRECTORY "${_source}/${_relative}")
      message(FATAL_ERROR "Release checksum file is missing: ${_relative}")
    endif()
    file(SHA256 "${_source}/${_relative}" _actual_file_sha)
    if(NOT _actual_file_sha STREQUAL _file_sha)
      message(FATAL_ERROR "Release file checksum mismatch: ${_relative}")
    endif()
    list(APPEND _release_files "${_relative}")
  endforeach()
endif()
list(REMOVE_DUPLICATES _release_files)

if("${_source}" STREQUAL "${ASSISTANT_PACKAGE_OUTPUT}")
  message(FATAL_ERROR "Model package input and staging output must be different directories")
endif()
file(MAKE_DIRECTORY "${ASSISTANT_PACKAGE_OUTPUT}")
# Avoid silently reusing old model files when the selected package changes.
foreach(_name IN LISTS _release_files)
  if(NOT EXISTS "${_source}/${_name}")
    file(REMOVE "${ASSISTANT_PACKAGE_OUTPUT}/${_name}")
  endif()
endforeach()
file(GLOB _old_shards "${ASSISTANT_PACKAGE_OUTPUT}/model-shards/*.gguf")
foreach(_old_shard IN LISTS _old_shards)
  get_filename_component(_old_name "${_old_shard}" NAME)
  if(NOT EXISTS "${_source}/model-shards/${_old_name}")
    file(REMOVE "${_old_shard}")
  endif()
endforeach()
foreach(_name IN LISTS _release_files)
  if(EXISTS "${_source}/${_name}")
    get_filename_component(_parent "${ASSISTANT_PACKAGE_OUTPUT}/${_name}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    configure_file("${_source}/${_name}" "${ASSISTANT_PACKAGE_OUTPUT}/${_name}" COPYONLY)
  endif()
endforeach()
if(IS_DIRECTORY "${_source}/model-shards")
  file(MAKE_DIRECTORY "${ASSISTANT_PACKAGE_OUTPUT}/model-shards")
  file(GLOB _shards "${_source}/model-shards/*.gguf")
  foreach(_shard IN LISTS _shards)
    get_filename_component(_name "${_shard}" NAME)
    configure_file("${_shard}" "${ASSISTANT_PACKAGE_OUTPUT}/model-shards/${_name}" COPYONLY)
  endforeach()
endif()
message(STATUS "Staged verified local model package at ${ASSISTANT_PACKAGE_OUTPUT}")
