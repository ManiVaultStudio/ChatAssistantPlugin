# Pure selection logic, also exercised without a platform SDK in package tests.
function(assistant_select_gpu_backend requested platform vulkan_available output)
  string(TOUPPER "${requested}" selected)
  if(NOT selected MATCHES "^(AUTO|CPU|METAL|VULKAN)$")
    message(FATAL_ERROR "Unknown ASSISTANT_GPU_BACKEND: ${requested}")
  endif()
  if(selected STREQUAL "AUTO")
    if(platform STREQUAL "Darwin")
      # Metal supports both native Intel and Apple Silicon builds.
      set(selected METAL)
    elseif(vulkan_available)
      set(selected VULKAN)
    else()
      set(selected CPU)
    endif()
  endif()
  if(selected STREQUAL "METAL" AND NOT platform STREQUAL "Darwin")
    message(FATAL_ERROR "The Metal backend requires macOS; select AUTO, CPU or VULKAN")
  endif()
  set(${output} "${selected}" PARENT_SCOPE)
endfunction()
